{
    "name": "@magaya/ai-document",
    "version": "2.4.2",
    "description": "Magaya extension to server data using AI",
    "main": "index.js",
    "scripts": {
        "postinstall": "npm link @magaya/hyperion-express-middleware",
        "test": "jest",
        "semantic-release": "npx semantic-release",
        "dev": "node index.js"
    },
    "files": [
        "index.js",
        "src/",
        "pages/",
        ".env"
    ],
    "release": {
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/github",
            "@semantic-release/npm",
            "@semantic-release/release-notes-generator",
            [
                "@semantic-release/git",
                {
                    "assets": [
                        "package.json"
                    ],
                    "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
                }
            ]
        ],
        "branches": [
            "master",
            {
                "name": "beta",
                "prerelease": true
            },
            {
                "name": "staging",
                "prerelease": true,
                "channel": "staging"
            }
        ]
    },
    "author": "Magaya",
    "license": "MIT",
    "dependencies": {
        "@magaya/db-helper": "1.0.0-next.65",
        "@magaya/ext-api-key-validation": "^1.0.0",
        "@magaya/extension-check-updates": "1.3.0-beta.9",
        "@magaya/extension-fs-helper": "^0.0.5",
        "@magaya/hyperion-extension-api-key": "0.0.3",
        "@magaya/socket-tunnel-node": "^0.2.1",
        "body-parser": "^1.20.2",
        "commander": "^2.17.1",
        "cors": "^2.8.5",
        "dateformat": "^3.0.3",
        "dotenv": "^8.2.0",
        "ejs": "^3.1.9",
        "express": "^4.18.2",
        "express-async-errors": "^3.1.1",
        "express-fileupload": "^1.1.6",
        "express-validator": "^6.9.2",
        "form-data": "^4.0.1",
        "https": "^1.0.0",
        "js2xmlparser": "^4.0.1",
        "node-fetch": "^2.6.11",
        "soap": "^1.0.0",
        "socket.io": "^4.5.3",
        "winston": "^3.8.2"
    },
    "devDependencies": {
        "@semantic-release/git": "^9.0.0",
        "babel-eslint": "^10.1.0",
        "eslint": "^7.2.0",
        "eslint-config-airbnb-base": "^14.2.1",
        "eslint-config-prettier": "^7.1.0",
        "eslint-plugin-import": "^2.22.1",
        "eslint-plugin-prettier": "^3.3.1",
        "husky": "^4.3.8",
        "jest": "^26.6.3",
        "lint-staged": "^10.5.3",
        "prettier": "^2.2.1",
        "semantic-release": "^17.0.7"
    },
    "husky": {
        "hooks": {
            "pre-commit": "npm test"
        }
    },
    "lint-staged": {
        "./src/**/*.js": [
            "npx prettier --write",
            "eslint src/**/*.js --fix"
        ]
    }
}
